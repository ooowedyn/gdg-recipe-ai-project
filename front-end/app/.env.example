# 프론트엔드가 호출할 FastAPI 서버의 절대 주소.
#
# - 브라우저(개발/웹): 비워두면 Vite 프록시(개발) 또는 같은 서버(빌드)로 자동 연결됩니다.
# - 앱(Capacitor): 반드시 서버 절대주소를 넣어야 합니다.
#   내 컴퓨터를 서버로 쓸 때는 cloudflared 터널이 준 https 주소를 넣으세요.
#
# 사용법: 이 파일을 복사해 .env 로 만들고 값을 채운 뒤 `npm run build`
#   cp .env.example .env
#
# 예:
# VITE_API_BASE=https://abc-123.trycloudflare.com

VITE_API_BASE=
